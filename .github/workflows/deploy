name: Deploy Static HTML to Pages

on:
  push:
    branches:
      - main # Triggers the workflow every time you push to the main branch
  workflow_dispatch: # Allows you to manually trigger this workflow from the Actions tab

# Set permissions of the GITHUB_TOKEN to allow deployment to GitHub Pages
permissions:
  contents: read
  pages: write
  id-token: write

# Allow only one concurrent deployment to avoid conflicting updates
concurrency:
  group: "pages"
  cancel-in-progress: true

jobs:
  deploy:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4 # Clones your repository into the runner

      - name: Setup Pages
        uses: actions/configure-pages@v5 # Configures Pages for the runner

      - name: Upload Artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: '.' # Uploads your entire repository root (where your index.html lives)

      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4 # Publishes the site live
